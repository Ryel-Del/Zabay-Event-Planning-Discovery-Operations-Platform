{
  "name": "zabay-backend",
  "version": "1.0.0",
  "description": "Zabay Event Planning & Operations Platform - Express.js & PostgreSQL Backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run build && node --test tests/api.test.js tests/security.test.js tests/production-auth.test.js",
    "test:fresh": "npm run build && node --test tests/fresh-db.test.js"
  },
  "keywords": [
    "zabay",
    "events",
    "bohol",
    "express",
    "postgresql"
  ],
  "author": "Zabay Engineering",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.10.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
