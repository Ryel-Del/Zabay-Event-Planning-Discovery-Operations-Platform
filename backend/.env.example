PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zabay_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=zabay_db
PGUSER=postgres
PGPASSWORD=postgres

# Configure an operator account even in development; never use these example values publicly.
OPERATOR_USERNAME=local-operator
OPERATOR_PASSWORD=replace-with-a-long-local-secret
